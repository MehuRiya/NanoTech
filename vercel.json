{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "projectSettings": {
    "rootDirectory": ".",
    "outputDirectory": ".next",
    "nodeVersion": "20.x"
  },
  "env": [
    {
      "key": "NODE_ENV",
      "value": "production"
    }
  ],
  "regions": ["iad1"],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
